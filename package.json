{
  "name": "financemanagerdesktop",
  "version": "1.0.0",
  "description": "Finance Manager Desktop App",
  "main": "electron/dist/index.js",
  "scripts": {
    "build": "cd frontend && npm run build && cd ../backend && npm run build && cd ../electron && npm run build",
    "start": "concurrently \"cd frontend && npm run dev\" \"cd backend && npm run dev\" \"cd electron && npm run dev\"",
    "node": "nvm use 24.13.0",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.patriks.finance-manager",
    "productName": "FinanceManager",
    "files": [
      "electron/dist/**",
      "electron/assets/**",
      "frontend/dist/**",
      "backend/dist/**",
      "backend/.env"
    ],
    "directories": {
      "output": "build"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "electron/assets/logo.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/logo.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/assets/logo.ico"
    }
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^18.17.0",
    "concurrently": "^9.1.2",
    "electron": "^35.1.2",
    "electron-builder": "^24.13.3",
    "typescript": "^5.8.2"
  },
  "author": "Patriks",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "electron-store": "^8.2.0",
    "express": "^5.3.0",
    "moment": "^2.31.0",
    "plaid": "^31.1.0"
  }
}
